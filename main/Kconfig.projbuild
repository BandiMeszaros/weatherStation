menu "Weather Station Configuration"

    config SENSOR_I2C_SDA
        int "SDA GPIO Number"
        default 22
        help
            GPIO number to use for the I2C SDA line.

    config SENSOR_I2C_SCL
        int "SCL GPIO Number"
        default 23
        help
            GPIO number to use for the I2C SCL line.

    config MEASUREMENT_INTERVAL_MS
        int "Measurement Interval (ms)"
        default 20000
        range 500 6000000
        help
            How often to read from the GXHT30 sensor.

    config WIFI_SSID
        string "WiFi SSID"
        default "your_wifi_ssid"
        help
            SSID of the WiFi network to connect to.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "your_wifi_password"
        help
            Password of the WiFi network.

    config MQTT_BROKER_URL
        string "MQTT Broker URL"
        default "mqtt://192.168.1.100"
        help
            URL of the MQTT broker (e.g., mqtt://192.168.1.100).

endmenu