# Copy this file to .env and fill in your real values.
# .env is gitignored, so secrets never get committed.
#
# Apply the values to sdkconfig with:
#     python3 scripts/apply_env.py
#
# See scripts/apply_env.py for the full list of supported keys.

WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

MQTT_BROKER_IP=192.168.1.160
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=indoor
